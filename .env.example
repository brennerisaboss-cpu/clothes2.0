# Local development. Any Postgres 14+ works; Supabase is a fine shortcut.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clothes

# Your base currency for price_base. Comps are compared in this currency,
# always at the FX rate recorded when each listing was observed.
BASE_CURRENCY=EUR

# Yahoo! JAPAN Shopping item search v3. Application ID only — no Yahoo account
# linkage. Register at https://e.developer.yahoo.co.jp/register
# Rate limit: 30 requests/minute per application ID.
YAHOO_APP_ID=

# Identifies your polling to shop owners so they can contact you or ask you to
# stop. Set it before running probe-shops or poll.
PROBE_CONTACT=

# Rakuten Ichiba item search. NOTE: Rakuten frames these APIs as provided for
# affiliate purposes, and the affiliate terms prohibit links on sites promoting
# reselling. Read the terms before registering — this tool places no links, but
# the judgement is yours. https://webservice.rakuten.co.jp/
RAKUTEN_APP_ID=

# eBay Browse API (active listings only; no sold data is available to us).
# Production access to the Buy APIs may require eBay's Application Growth Check.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Who may open the dashboard.
#
# Set it to a long random string unless this is running STRICTLY on localhost
# and unforwarded. That is a narrower rule than "set it when you deploy": a
# tunnel, a port-forward, a VPN, a container publishing the port or a start
# command that binds 0.0.0.0 all make it reachable by other people, and none of
# them look any different from the inside.
#
# With no password set, only a server we started ourselves on 127.0.0.1 serves
# anything; everything else gets a 503 explaining why.
APP_PASSWORD=

# Where the server listens. `npm run dev`, `npm start` and the launcher set
# this to 127.0.0.1 for you — nothing else should need to change it. Widening
# it (0.0.0.0, a LAN address) is what APP_PASSWORD exists for, and the app
# refuses to serve a widened bind without one.
APP_BIND=127.0.0.1

# Set this to 1 ONLY if whatever sits in front of this OVERWRITES the
# x-forwarded-for header rather than appending to what a client sent. Vercel
# and Cloudflare do; a hand-rolled nginx often does not.
#
# It decides whether failed password attempts can be counted per client. Left
# unset they all share one counter, which is slower for you and safe: with it
# set wrongly, a guesser puts a fresh fake address on every request and never
# reaches the lockout at all.
APP_TRUST_PROXY=

# The capture endpoint's token. A long random string, shared by anything that
# records listings without a browser session: the mailbox poller, the capture
# bookmarklet, a phone shortcut. Without one, /api/capture refuses everything —
# an endpoint that opens itself because nobody set a secret is not a gate.
CAPTURE_TOKEN=

# Where the app is reachable from those callers. Usually the local server.
APP_URL=http://127.0.0.1:3000

# The mailbox holding your saved-search alerts. Grailed, Vestiaire and The
# RealReal all offer alert emails; point them here (a dedicated address, or a
# filter into their own folder) and `npm run mailbox` reads what they send.
# Nothing in that path contacts those sites.
MAILBOX_HOST=
MAILBOX_USER=
MAILBOX_PASSWORD=
MAILBOX_PORT=993
MAILBOX_FOLDER=INBOX
